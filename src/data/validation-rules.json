{
  "rules": {
    "fullName": {
      "required": true,
      "minLength": 2,
      "maxLength": 80,
      "disallowedWords": [
        "hi",
        "hii",
        "hiii",
        "hello",
        "helo",
        "hey",
        "skip",
        "none",
        "developer",
        "worker",
        "idk",
        "test",
        "good morning",
        "how are you"
      ],
      "errorMessage": "Please enter a valid full name (letters only, not a greeting or command)."
    },
    "occupation": {
      "required": true,
      "minLength": 2,
      "maxLength": 100,
      "disallowedWords": [
        "hi",
        "hii",
        "hello",
        "hey",
        "skip",
        "good morning"
      ],
      "errorMessage": "Please describe your job, profession or occupation."
    },
    "email": {
      "required": true,
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "errorMessage": "Please enter a valid email address (e.g., name@example.com)."
    },
    "phone": {
      "required": true,
      "pattern": "^[+]?[(]?[0-9]{1,4}[)]?[-\\s./0-9]{6,20}$",
      "errorMessage": "Please enter a valid telephone number with country/area code."
    },
    "url": {
      "required": false,
      "pattern": "^(https?:\\/\\/)?([\\da-z.-]+)\\.([a-z.]{2,6})([\\/\\w .-]*)*\\/?$|^([a-zA-Z0-9_-]+)$",
      "errorMessage": "Please enter a valid URL or profile identifier."
    },
    "year": {
      "required": true,
      "pattern": "^(19|20)\\d{2}$",
      "errorMessage": "Please enter a 4-digit valid year (e.g., 2024)."
    },
    "percentageOrGpa": {
      "required": false,
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,2})?(%|\\/10|\\/4)?$",
      "errorMessage": "Please enter a valid score (e.g., 3.8/4.0, 8.5/10, or 85%)."
    }
  }
}
